# TenderOS environment variables. Copy to .env.local and fill in.
# Placeholders only: never commit real values. .env* files are gitignored.

# --- Supabase (public values, safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only; never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection used by the background worker (session pooler in hosted Supabase)
DATABASE_URL=

# --- Application ---
APP_URL=http://localhost:3000
# 32 random bytes, hex or base64. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Shared secret for internal workflow endpoints/webhooks
WORKFLOW_SECRET=

# --- AI (Anthropic). Not required while AI is off; simulation runs never call a model. ---
# Real AI runs only on real tenders, and only when AI is switched on: for an
# organisation by the system_settings.ai_enabled column (when it exists), and
# until then for the whole deployment by AI_ENABLED=true. Anything missing
# below makes an AI step fail with a clear message; it never falls back silently.
# Hosted: set these as Edge Function secrets (supabase secrets set), not in files.
AI_ENABLED=false
ANTHROPIC_API_KEY=

# Model per cost tier. The agent registry decides each agent's tier (LOW, MID,
# HIGH) and high-value or complex work moves up one tier. Recommended values:
# Haiku for LOW, Sonnet for MID, Opus for HIGH (QA Reviewer). Web research
# needs a model that supports the web search tool (Sonnet or Opus), so a LOW-tier
# agent doing web research is moved to MID.
AI_MODEL_LOW=claude-haiku-5-5
AI_MODEL_MID=claude-sonnet-5-5
AI_MODEL_HIGH=claude-opus-5-5

# USD per million tokens for each tier's model: input/output[/cacheRead[/cacheWrite]].
# Required: without a price the cost cannot be tracked against the daily budget.
# Cache read defaults to 0.1x input and cache write to 1.25x input when omitted.
# Values at the time of writing (check https://platform.claude.com/docs/en/about-claude/pricing):
#   Haiku 5.5  0.10/0.50/0.01/0.125  (prompts up to 100k tokens; AI_MAX_INPUT_TOKENS keeps calls under that)
#   Sonnet 5.5 2/10/0.10/2.50
#   Opus 5.5   4/20/0.20/5
AI_PRICE_LOW=0.10/0.50/0.01/0.125
AI_PRICE_MID=2/10/0.10/2.50
AI_PRICE_HIGH=4/20/0.20/5
# Price for an agent's model_override, if any agent has one
AI_PRICE_OVERRIDE=

# Optional: thinking effort per tier (low, medium, high, xhigh, max). Unset uses the model's default.
AI_EFFORT_LOW=
AI_EFFORT_MID=
AI_EFFORT_HIGH=

# Limits (defaults shown). A prompt over AI_MAX_INPUT_TOKENS is refused, a task that
# has spent AI_MAX_TASK_COST_USD starts no further call, and no task may spend more
# than what is left of the organisation's daily AI budget.
# AI_TIMEOUT_MS=120000
# AI_MAX_ATTEMPTS=3
# AI_MAX_INPUT_TOKENS=100000
# AI_MAX_OUTPUT_TOKENS=32000
# AI_MAX_TASK_COST_USD=2
# AI_CHUNK_CHARS=100000
# Estimated tender value (ZAR) at or above which work moves up one model tier. Unset: never.
# AI_HIGH_VALUE_ZAR=
# Cost of one web search in USD (Anthropic charges $10 per 1,000)
# AI_WEB_SEARCH_COST_USD=0.01
# Web research for the Scout and Intelligence Analyst. Off unless this is true (or, when the
# system_settings.ai_web_research_enabled column exists, that column is true for the organisation).
# AI_WEB_RESEARCH_ENABLED=false

# Live evaluation against labelled fixtures: npm run eval:live (does nothing without ANTHROPIC_API_KEY)
# EVAL_FIXTURES=roads-rehabilitation,adversarial-prompt-injection
# EVAL_MAX_USD=5
# EVAL_MIN_RECALL=0.8
# EVAL_PIPELINE=false
# EVAL_STRICT=false

# --- Gmail sending (optional; company SMTP mailboxes need nothing here) ---
# OAuth client from Google Cloud (Web application). Authorised redirect URI:
# <APP_URL>/api/email/google/callback. Scope used: gmail.send.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Monitoring ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Worker tuning ---
WORKER_CONCURRENCY=2
# Duration of each simulated agent step in milliseconds
SIMULATION_STEP_MS=4000
