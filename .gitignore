# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent worktrees (isolated working copies used during parallel builds)
/.claude/worktrees/

# local supabase
supabase/.branches
supabase/.temp
# playwright
/test-results/
/playwright-report/
!.env.example

# generated email previews; a small representative set under emails/preview/screenshots is committed
/emails/preview/index.html
/emails/preview/frames/
/emails/preview/screenshots/*
!/emails/preview/screenshots/auth-confirmation.light.desktop.png
!/emails/preview/screenshots/auth-confirmation.dark.desktop.png
!/emails/preview/screenshots/auth-confirmation.light.mobile.png
!/emails/preview/screenshots/auth-reauthentication.dark.mobile.png
!/emails/preview/screenshots/team-invitation.light.desktop.png
!/emails/preview/screenshots/bid-delivered.dark.desktop.png
!/emails/preview/screenshots/closing-reminders.light.desktop.png
!/emails/preview/screenshots/welcome.dark.mobile.png
